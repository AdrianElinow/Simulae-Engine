{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "@simulae/human_body.json",
    "title": "Human Body",
    "description": "Human Body",
    "allOf": [
        {
            "$ref": "@simulae/simulae_node.json"
        }
    ],
    "properties": {
        "nodetype": {
            "const": "Object"
        },
        "references": {
            "type": "object",
            "properties": {
                "name": {
                    "const": "Human Body"
                },
                "species": {
                    "const": "Human"
                },
                "gender": {
                    "type": "string",
                    "enum": [
                        "Male",
                        "Female"
                    ],
                    "distribution": {
                        "type": "categorical",
                        "weights": {
                            "Male": 0.51,
                            "Female": 0.49
                        }
                    }
                }
            }
        },
        "attributes": {
            "type": "object",
            "properties": {
                "age": {
                    "type": "integer",
                    "unit": "years",
                    "distribution": {
                        "type": "bell_curve",
                        "min": 0,
                        "max": 115,
                        "average": 30,
                        "stddev": 15
                    }
                },
                "body_height": {
                    "type": "number",
                    "unit": "meters",
                    "distribution": {
                        "type": "bell_curve",
                        "min": 1.45,
                        "max": 1.95,
                        "average": 1.74,
                        "stddev": 0.1
                    }
                }
            }
        }
    },
    "relations": {
        "components": {
            "object": {
                "head": {
                    "$ref": "@simulae/Human/head.json"
                },
                "torso": {
                    "$ref": "@simulae/Human/torso.json"
                },
                "left-arm": {
                    "$ref": "@simulae/Human/left_arm.json"
                },
                "right-arm": {
                    "$ref": "@simulae/Human/right_arm.json"
                },
                "left-leg": {
                    "$ref": "@simulae/Human/left_leg.json"
                },
                "right-leg": {
                    "$ref": "@simulae/Human/right_leg.json"
                }
            }
        }
    }
}
